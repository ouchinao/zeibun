<?xml version="1.0" encoding="utf-8"?>
<!-- 全法令を保存すると files/db/ の SQLite が数百 MB になり、自動バックアップの 25MB 上限を
     超えて黙って失敗するだけなので、対象外だと明示する（設計書 §11 I、Phase R R13）。
     アプリ全体を対象外にしないのは、設定（SharedPreferences）は引き継ぎたいため。API 31 以降の規則 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="db" />
    </device-transfer>
</data-extraction-rules>
